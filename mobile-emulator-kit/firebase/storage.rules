rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Max 1 MB per uploaded file (docs/photos). Enforced here in addition to
    // the client-side FileSizes check.
    function underSizeLimit() {
      return request.resource == null || request.resource.size < 1 * 1024 * 1024;
    }
    function isSignedIn() {
      return request.auth != null;
    }

    match /company/{companyItem} {
      allow read: if true;
      allow write: if isSignedIn() && underSizeLimit();
    }

    match /pending/{pendingItem} {
      allow read: if true;
      allow write: if isSignedIn() && underSizeLimit();
    }

    match /merchantApplications/{item} {
      allow read: if true;
      allow write: if isSignedIn() && underSizeLimit();
    }

    match /showcase/{item} {
      allow read: if true;
      allow write: if isSignedIn() && underSizeLimit();
    }

    match /groups/{item} {
      allow read: if true;
      allow write: if isSignedIn() && underSizeLimit();
    }

    match /coupons/{item} {
      allow read: if true;
      allow write: if isSignedIn() && underSizeLimit();
    }

    match /approvedCompany/{approvedCompanyItem} {
      allow read: if true;
      allow write: if isSignedIn() && underSizeLimit();
    }

    match /approvedApplications/{approvedCompanyItem} {
      allow read: if true;
      allow write: if isSignedIn() && underSizeLimit();
    }

    match /approvedCampaigns/{approvedCompanyItem} {
      allow read: if true;
      allow write: if isSignedIn() && underSizeLimit();
    }

    match /news/{newsItem} {
      allow read: if true;
      allow write: if isSignedIn() && underSizeLimit();
    }

    match /adBoard/{adItem} {
      allow read: if true;
      allow write: if isSignedIn() && underSizeLimit();
    }

    match /scholarship/{scholarship} {
      allow read: if true;
      allow write: if isSignedIn() && underSizeLimit();
    }

    match /touristicPlaces/{touristicPlace} {
      allow read: if true;
      allow write: if isSignedIn() && underSizeLimit();
    }

    match /usefulLinks/{document} {
      allow read: if true;
      allow write: if isSignedIn() && underSizeLimit();
    }
  }
}
