{
  "hosting": [
    {
      "target": "app",
      "public": "build/web",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "X-Frame-Options",
              "value": "SAMEORIGIN"
            },
            {
              "key": "Content-Security-Policy-Report-Only",
              "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://www.gstatic.com https://accounts.google.com https://www.googletagmanager.com https://apis.google.com https://www.google.com https://maps.googleapis.com https://appleid.apple.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://*.googleapis.com https://*.gstatic.com https://*.firebaseio.com wss://*.firebaseio.com https://*.cloudfunctions.net https://*.firebaseapp.com https://www.google.com https://accounts.google.com https://appleid.apple.com https://*.google-analytics.com; worker-src 'self' blob:; frame-src 'self' blob: https://accounts.google.com https://apis.google.com https://www.google.com https://appleid.apple.com https://www.recaptcha.net https://recaptcha.google.com https://*.firebaseapp.com https://maps.googleapis.com; manifest-src 'self'; media-src 'self' blob: data:"
            }
          ]
        },
        {
          "source": "/icons/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400"
            }
          ]
        },
        {
          "source": "/favicon.png",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400"
            }
          ]
        }
      ]
    }
  ],
  "emulators": {
    "auth": {
      "port": 3000,
      "persist": true
    },
    "firestore": {
      "port": 3004,
      "persist": true
    },
    "storage": {
      "port": 3005,
      "persist": true
    },
    "ui": {
      "enabled": true
    },
    "exportOnExit": "./emulator-data",
    "importOnStart": "./emulator-data"
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "savehatay",
          "appId": "1:128619632572:android:deb8dc72bddd03c8c6bdb9",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "savehatay",
          "appId": "1:128619632572:ios:38588d72e15e331cc6bdb9",
          "uploadDebugSymbols": true,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "savehatay",
          "configurations": {
            "android": "1:128619632572:android:deb8dc72bddd03c8c6bdb9",
            "ios": "1:128619632572:ios:38588d72e15e331cc6bdb9",
            "web": "1:128619632572:web:2c62de8037f21ea0c6bdb9"
          }
        }
      }
    }
  }
}
