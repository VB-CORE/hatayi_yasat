{
  "hosting": [
    {
      "target": "app",
      "public": "build/web",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "**/*.symbols"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            },
            {
              "key": "Cross-Origin-Opener-Policy",
              "value": "same-origin-allow-popups"
            },
            {
              "key": "Permissions-Policy",
              "value": "geolocation=(self), camera=(self), microphone=(), payment=(), usb=(), browsing-topics=()"
            },
            {
              "key": "Content-Security-Policy-Report-Only",
              "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://www.gstatic.com https://apis.google.com https://accounts.google.com https://www.google.com https://www.recaptcha.net https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://accounts.google.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: https://firebasestorage.googleapis.com; connect-src 'self' https://*.googleapis.com https://*.cloudfunctions.net https://www.gstatic.com https://fonts.gstatic.com https://*.google-analytics.com https://www.googletagmanager.com https://accounts.google.com https://www.google.com https://www.recaptcha.net; frame-src https://savehatay.firebaseapp.com https://accounts.google.com https://appleid.apple.com https://www.google.com https://www.recaptcha.net https://www.hatayiyasat.com; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
            }
          ]
        },
        {
          "source": "/icons/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400"
            }
          ]
        },
        {
          "source": "/favicon.png",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400"
            }
          ]
        }
      ]
    }
  ],
  "emulators": {
    "auth": {
      "port": 3000,
      "persist": true
    },
    "firestore": {
      "port": 3004,
      "persist": true
    },
    "storage": {
      "port": 3005,
      "persist": true
    },
    "ui": {
      "enabled": true
    },
    "exportOnExit": "./emulator-data",
    "importOnStart": "./emulator-data"
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "savehatay",
          "appId": "1:128619632572:android:deb8dc72bddd03c8c6bdb9",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "savehatay",
          "appId": "1:128619632572:ios:38588d72e15e331cc6bdb9",
          "uploadDebugSymbols": true,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "savehatay",
          "configurations": {
            "android": "1:128619632572:android:deb8dc72bddd03c8c6bdb9",
            "ios": "1:128619632572:ios:38588d72e15e331cc6bdb9",
            "web": "1:128619632572:web:2c62de8037f21ea0c6bdb9"
          }
        }
      }
    }
  }
}
