rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email in
           get(/databases/$(database)/documents/adminList/config).data.emails;
    }

    function hasPerm(p) {
      return isSignedIn()
        && 'permissions' in request.auth.token
        && (p in request.auth.token.permissions);
    }

    // Banlı kullanıcı hiçbir yere içerik yazamaz. Kullanıcı dokümanından
    // okunuyor çünkü custom claim, kullanıcının elindeki mevcut token'a bir
    // saate kadar yansımaz; ban ise anında geçerli olmalı.
    function isBanned() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.get('isBanned', false) == true;
    }

    // Doğrulanmış esnaf = mağazanın ownerId'si. Ayrı bir isVerified bayrağı yok.
    function isMerchantOf(storeId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/approvedApplications/$(storeId)).data.ownerId
           == request.auth.uid;
    }

    function isCouponOwner(couponId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/coupons/$(couponId)).data.merchantUid
           == request.auth.uid;
    }

    function affects(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // --- Topluluk (grup / konu) yardımcıları ---

    // Doküman yolları tek yerde dursun diye. Aynı dokümana birden fazla
    // yardımcıdan erişilse bile Firestore okumayı tekilleştirir.
    function groupData(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data;
    }

    function myMembershipData(groupId) {
      return get(
        /databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)
      ).data;
    }

    function isGroupOwner(groupId) {
      return groupData(groupId).creatorUid == request.auth.uid;
    }

    function isGroupMember(groupId) {
      return exists(
        /databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)
      );
    }

    // Grup düzeyinde yönetici: grubu kuran kişi ya da 'admin' rolüne yükseltilmiş
    // bir üye. Platform personelini ifade eden isAdmin() ile karıştırılmamalı.
    // Rol okuması exists() ile korunuyor: üyelik dokümanı yoksa get() hata verir.
    function isGroupAdmin(groupId) {
      return isGroupOwner(groupId)
        || (isGroupMember(groupId)
            && myMembershipData(groupId).get('role', 1) == 2);
    }

    // Yazma kilitleri grup dokümanında yaşar, her yüzey için bir bayrak. Alanın
    // hiç bulunmaması "kilitli değil" demektir; böylece bu özellikten önce
    // oluşturulmuş gruplar için veri taşımaya gerek kalmaz.
    function isUnlocked(groupId, field) {
      return groupData(groupId).get(field, false) != true;
    }

    // Kilit yalnızca sıradan üyeleri susturur — grubu yönetenler kilitli grupta
    // da yazmaya devam eder. Sıralama, kilitsiz olan yaygın durumun tek bir
    // okumaya mal olması içindir.
    function canWriteTo(groupId, field) {
      return isUnlocked(groupId, field) || isGroupAdmin(groupId) || isAdmin();
    }

    function discussionExists(groupId, discussionId) {
      return exists(
        /databases/$(database)/documents/groups/$(groupId)/discussions/$(discussionId)
      );
    }

    // Grup dokümanının kendisi güncellenirken sahiplik kontrolü. resource zaten
    // yüklü olduğundan isGroupOwner()'ın aksine ekstra okuma yapmaz.
    function isCreatorOfThisGroup() {
      return resource.data.creatorUid == request.auth.uid;
    }

    // Grup künyesi: kurucunun serbestçe düzenleyebildiği alanlar.
    function groupProfileFields() {
      return ['name', 'description', 'imageUrl', 'categoryValue',
              'categoryName', 'isClosed', 'updatedAt'];
    }

    // Yazma kilitleri: kurucuya ek olarak grup yöneticilerinin de
    // çevirebildiği tek alan kümesi.
    function groupLockFields() {
      return ['isPostsLocked', 'isDiscussionsLocked', 'isCommentsLocked',
              'updatedAt'];
    }

    // Gelen dokümanın yazarı (create bağlamı).
    function isIncomingAuthor() {
      return request.resource.data.author.uid == request.auth.uid;
    }

    // Mevcut dokümanın yazarı (update bağlamı).
    function isAuthor() {
      return resource.data.author.uid == request.auth.uid;
    }

    // Hiçbir yerde kalıcı silme yok: "silmek" sadece bu bayrakları çevirir.
    function isSoftDelete() {
      return affects(['isDeleted', 'deletedAt', 'updatedAt']);
    }

    // Denormalize sayaçları (memberCount, entryCount, likeCount) client taşıdığı
    // için birer birer değişebilir ve asla negatife düşemez.
    // Eksik alan 0 sayılır: eski kullanıcı/grup dokümanları ilk artışta
    // resource.data[field] erişiminde evaluation error vermesin.
    function movesCounterByOne(field) {
      return affects([field])
        && request.resource.data[field] is int
        && request.resource.data[field] >= 0
        && (request.resource.data[field] == resource.data.get(field, 0) + 1
            || request.resource.data[field] == resource.data.get(field, 0) - 1);
    }

    // users/{uid} üzerindeki gösterim sayaçları. Kullanıcı içerik yazarken
    // aynı batch'te birer birer taşır; ban bayrakları bu listede yok, yani
    // banlı kullanıcı kendi bayrağını temizleyemez.
    function movesOwnCounter() {
      return movesCounterByOne('postCount')
        || movesCounterByOne('discussionCount')
        || movesCounterByOne('commentCount')
        || movesCounterByOne('likeCount')
        || movesCounterByOne('groupCount')
        || movesCounterByOne('voteCount');
    }

    // Store rating aggregates (ratingSum / ratingCount). Missing fields count as 0
    // so older documents without these keys can still accept the first vote.
    function storeRatingCount() {
      return resource.data.get('ratingCount', 0);
    }

    function storeRatingSum() {
      return resource.data.get('ratingSum', 0);
    }

    function movesStoreRatingUp() {
      return affects(['ratingSum', 'ratingCount'])
        && request.resource.data.ratingCount is int
        && request.resource.data.ratingSum is int
        && request.resource.data.ratingCount == storeRatingCount() + 1
        && request.resource.data.ratingSum - storeRatingSum() >= 1
        && request.resource.data.ratingSum - storeRatingSum() <= 5;
    }

    function movesStoreRatingDown() {
      return affects(['ratingSum', 'ratingCount'])
        && request.resource.data.ratingCount is int
        && request.resource.data.ratingSum is int
        && request.resource.data.ratingCount == storeRatingCount() - 1
        && request.resource.data.ratingCount >= 0
        && request.resource.data.ratingSum >= 0
        && storeRatingSum() - request.resource.data.ratingSum >= 1
        && storeRatingSum() - request.resource.data.ratingSum <= 5;
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth.uid == uid
        && request.resource.data.roleType == 2
        && request.resource.data.permissions.size() == 0
        && request.resource.data.get('isBanned', false) == false
        && !('merchantStoreId' in request.resource.data);
      allow update: if request.auth.uid == uid
        && affects(['fcmToken', 'displayName', 'photoUrl', 'avatarType',
                    'application', 'updatedAt']);
      allow update: if request.auth.uid == uid && movesOwnCounter();
      allow update: if isAdmin();

    }

    match /approvedApplications/{storeId} {
      allow read: if true;
      allow write: if isAdmin();
      // Onaylı esnaf kendi mekanının künyesini yönetir; onay durumu
      // (isApproved), sahiplik (ownerId) ve sayaçlar dışarıda kalır.
      // Vitrin alt koleksiyon: approvedApplications/{id}/showcase/{id}.
      allow update: if resource.data.ownerId == request.auth.uid
        && affects(['description', 'images',
                    'openTime', 'closeTime', 'updatedAt',
                    'name', 'phone', 'address', 'category',
                    'isCommentEnabled']);
      allow update: if isSignedIn()
        && affects(['visitCount'])
        && request.resource.data.visitCount
           == resource.data.get('visitCount', 0) + 1;
      // Oy create/delete batch'i store sayaçlarını ±1 count / ±(1..5) sum oynatır.
      allow update: if isSignedIn()
        && (movesStoreRatingUp() || movesStoreRatingDown());

      match /votes/{voterUid} {
        allow read: if isSignedIn();
        // Yeni oy: puan 1–5, yazar = oturum; mekan yorumlara kapalıysa create yok.
        allow create: if isSignedIn()
          && voterUid == request.auth.uid
          && request.resource.data.voterUid == request.auth.uid
          && request.resource.data.score is int
          && request.resource.data.score >= 1
          && request.resource.data.score <= 5
          && !isBanned()
          && get(/databases/$(database)/documents/approvedApplications/$(storeId))
               .data.get('isCommentEnabled', true) == true;
        // Soft-delete sonrası yeniden oy: set() mevcut dokümana düşer → update.
        allow update: if isSignedIn()
          && voterUid == request.auth.uid
          && resource.data.get('isDeleted', false) == true
          && request.resource.data.get('isDeleted', false) == false
          && request.resource.data.voterUid == request.auth.uid
          && request.resource.data.score is int
          && request.resource.data.score >= 1
          && request.resource.data.score <= 5
          && !isBanned()
          && get(/databases/$(database)/documents/approvedApplications/$(storeId))
               .data.get('isCommentEnabled', true) == true;
        // Oy sahibi yalnızca yorum metnini günceller; puan aggregate dışı kalır.
        allow update: if isSignedIn()
          && voterUid == request.auth.uid
          && !isBanned()
          && affects(['comment', 'updatedAt']);
        // Mekan sahibi yalnızca yanıt alanlarına dokunabilir; puan/yorum korunur.
        allow update: if isMerchantOf(storeId)
          && affects(['merchantReply', 'merchantReplyAt', 'updatedAt'])
          && (request.resource.data.merchantReply is string
              || request.resource.data.merchantReply == null);
        allow update: if isSoftDelete()
          && (request.auth.uid == voterUid || isAdmin());
        allow delete: if false;
      }

      // Vitrin kartları. Sadece mağaza sahibi yazar, herkes okur. Hard delete yok.
      match /showcase/{moduleId} {
        allow read: if true;
        allow create: if isMerchantOf(storeId) && !isBanned();
        allow update: if isMerchantOf(storeId) && !isBanned();
        allow update: if isAdmin();
        allow delete: if false;
      }
    }

    match /topics/{topicId} {
      allow read: if isSignedIn();
      allow create: if (isAdmin() || hasPerm(2)) && !isBanned();
      allow update, delete: if isAdmin();

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && isIncomingAuthor() && !isBanned();
        allow update: if isSoftDelete() && (isAuthor() || isAdmin());
        allow delete: if false;
      }
    }

    match /groups/{groupId} {
      // Grup listesi herkese açık; katılmak ve içeriğini okumak değil.
      allow read: if true;
      allow create: if hasPerm(1)
        && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.memberCount == 1
        && !isBanned();
      // Grubu kuran kişi künyeyi ve kilitleri düzenler; yükseltilmiş grup
      // yöneticisi sadece kilitleri çevirir; üyelik sayacını herkes taşır.
      allow update: if isAdmin()
        || (isCreatorOfThisGroup()
            && (affects(groupProfileFields().concat(groupLockFields()))
                || isSoftDelete()))
        || (isGroupAdmin(groupId) && affects(groupLockFields()))
        || (isSignedIn() && movesCounterByOne('memberCount') && !isBanned());
      allow delete: if isAdmin();

      // Üyelik. Ayrılmak bir soft-delete'tir; sayımlar isDeleted == false
      // filtresiyle yapılmalı.
      match /members/{memberUid} {
        allow read: if isSignedIn();
        allow create: if request.auth.uid == memberUid && !isBanned();
        allow update: if isSoftDelete()
          && (request.auth.uid == memberUid || isGroupOwner(groupId) || isAdmin());
        // Yeniden katılma, ayrılırken soft-delete edilen üyeliğin üzerine yazar.
        allow update: if request.auth.uid == memberUid
          && resource.data.isDeleted == true
          && request.resource.data.isDeleted == false;
        allow delete: if false;
      }

      // Duvar gönderileri. Yazarları üyelerdir; içerik değiştirilemez, sadece
      // beğeni sayacı hareket eder. Duvar kilitliyken beğenmek açık kalır —
      // kilit yeni içerikle ilgilidir, eski içeriğe tepki vermekle değil.
      match /posts/{postId} {
        allow read: if isSignedIn();
        allow create: if isGroupMember(groupId) && isIncomingAuthor()
          && canWriteTo(groupId, 'isPostsLocked') && !isBanned();
        allow update: if isGroupMember(groupId) && movesCounterByOne('likeCount')
          && !isBanned();
        allow delete: if false;

        // Beğeni, gönderinin altında ve beğenen kişiyle anahtarlanır. Gönderinin
        // bir kopyasını taşımaz; hangi gönderi olduğunu yolun kendisi söyler.
        match /likes/{likerUid} {
          allow read: if isSignedIn();
          allow create: if request.auth.uid == likerUid
            && request.resource.data.uid == likerUid
            && isGroupMember(groupId) && !isBanned();
          allow update: if request.auth.uid == likerUid && isSoftDelete()
            && !isBanned();
          allow delete: if false;
        }
      }

      // Tartışmalar ve cevapları, gönderilerle aynı erişim şeklini paylaşır.
      match /discussions/{discussionId} {
        allow read: if isSignedIn();
        allow create: if isGroupMember(groupId) && isIncomingAuthor()
          && canWriteTo(groupId, 'isDiscussionsLocked') && !isBanned();
        // entryCount artışı cevabın kendisiyle aynı batch'te gittiği için
        // tartışma kilidine değil yorum kilidine tabidir.
        allow update: if isGroupMember(groupId) && movesCounterByOne('entryCount')
          && canWriteTo(groupId, 'isCommentsLocked') && !isBanned();
        allow delete: if false;

        // Cevaplar. Tartışma açmak, başlığı ve ilk cevabı tek batch'te yazar;
        // rules batch öncesi durumu gördüğü için parent başlığı henüz var
        // olmayan cevap, açılış mesajıdır ve tartışma kilidine tabidir.
        // Sonraki her cevap yorumdur.
        match /entries/{entryId} {
          allow read: if isSignedIn();
          allow create: if isGroupMember(groupId) && isIncomingAuthor()
            && !isBanned()
            && (discussionExists(groupId, discussionId)
                ? canWriteTo(groupId, 'isCommentsLocked')
                : canWriteTo(groupId, 'isDiscussionsLocked'));
          allow update: if false;
          allow delete: if false;
        }
      }
    }

    match /coupons/{couponId} {
      allow read: if isSignedIn();
      allow create: if isMerchantOf(request.resource.data.storeId)
        && !isBanned()
        && request.resource.data.merchantUid == request.auth.uid
        && request.resource.data.ratio is int
        && request.resource.data.ratio >= 1
        && request.resource.data.ratio <= 100
        && request.resource.data.expiresAt is timestamp;
      allow update: if resource.data.merchantUid == request.auth.uid || isAdmin();
      allow delete: if false;

      // Doküman kimliği kullanan uid'idir: bir kullanıcı bir kupondan yalnızca
      // bir kez yararlanabilir, ikinci create aynı kimliğe düşer ve reddedilir.
      match /redemptions/{userUid} {
        allow read: if isCouponOwner(couponId)
          || request.auth.uid == userUid
          || isAdmin();
        allow create: if isCouponOwner(couponId)
          && request.resource.data.userUid == userUid
          && request.resource.data.merchantUid == request.auth.uid
          && !exists(
            /databases/$(database)/documents/coupons/$(couponId)/redemptions/$(userUid)
          );
        allow update, delete: if isAdmin();
      }
    }

    match /regionalCities/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /regionalTowns/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /towns/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /adminList/{document} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /allowedAdminClaims/{document} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /specialAgency/{agency} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /unApprovedApplications/{appId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /notifications/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /developers/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /logs/{document} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    // CollectionPaths.error — FirebaseLogger tarafından yazılır (örn. push
    // bildirimi hataları). Giriş yapmış herkes ekleyebilir; okuma ve değiştirme
    // sadece adminlerde. Bu match olmadan yazmalar prod'da varsayılan olarak
    // reddediliyordu.
    match /error/{document} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /approvedCampaigns/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /unApprovedCampaigns/{document} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /categories/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /groupCategories/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /unApprovedAdvertise/{document} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /approvedAdvertise/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /news/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /adBoard/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /scholarship/{scholarship} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /chainStores/{chainStore} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /touristicPlaces/{touristicPlace} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /usefulLinks/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
