rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email in
           get(/databases/$(database)/documents/adminList/config).data.emails;
    }

    function hasPerm(p) {
      return isSignedIn()
        && 'permissions' in request.auth.token
        && (p in request.auth.token.permissions);
    }

    function isMerchantOf(storeId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/approvedApplications/$(storeId)).data.ownerId
           == request.auth.uid;
    }

    function isCouponOwner(couponId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/coupons/$(couponId)).data.merchantUid
           == request.auth.uid;
    }

    function affects(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // --- Community (groups / topics) helpers ---

    function isGroupOwner(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data.creatorUid
        == request.auth.uid;
    }

    // Leaving is a soft-delete, so existence alone is not membership.
    function isGroupMember(groupId) {
      return exists(
          /databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)
        ).data.get('isDeleted', false) == false;
    }

    // Author of the existing document (update context).
    function isAuthor() {
      return resource.data.author.uid == request.auth.uid;
    }

    // Author of the incoming document (create context).
    function isIncomingAuthor() {
      return request.resource.data.author.uid == request.auth.uid;
    }

    // No hard delete anywhere: "deleting" only flips these soft-delete flags.
    function isSoftDelete() {
      return affects(['isDeleted', 'deletedAt', 'updatedAt']);
    }

    // Denormalised counters (memberCount, entryCount, likeCount) are moved by
    // the client, so they may only step by one and never go negative.
    function movesCounterByOne(field) {
      return movesCounterUp(field) || movesCounterDown(field);
    }

    function movesCounterUp(field) {
      return affects([field])
        && request.resource.data[field] is int
        && request.resource.data[field] == resource.data[field] + 1;
    }

    function movesCounterDown(field) {
      return affects([field])
        && request.resource.data[field] is int
        && request.resource.data[field] >= 0
        && request.resource.data[field] == resource.data[field] - 1;
    }

    // Store rating aggregates (ratingSum / ratingCount). Missing fields count as 0
    // so older documents without these keys can still accept the first vote.
    function storeRatingCount() {
      return resource.data.get('ratingCount', 0);
    }

    function storeRatingSum() {
      return resource.data.get('ratingSum', 0);
    }

    function movesStoreRatingUp() {
      return affects(['ratingSum', 'ratingCount'])
        && request.resource.data.ratingCount is int
        && request.resource.data.ratingSum is int
        && request.resource.data.ratingCount == storeRatingCount() + 1
        && request.resource.data.ratingSum - storeRatingSum() >= 1
        && request.resource.data.ratingSum - storeRatingSum() <= 5;
    }

    function movesStoreRatingDown() {
      return affects(['ratingSum', 'ratingCount'])
        && request.resource.data.ratingCount is int
        && request.resource.data.ratingSum is int
        && request.resource.data.ratingCount == storeRatingCount() - 1
        && request.resource.data.ratingCount >= 0
        && request.resource.data.ratingSum >= 0
        && storeRatingSum() - request.resource.data.ratingSum >= 1
        && storeRatingSum() - request.resource.data.ratingSum <= 5;
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth.uid == uid
        && request.resource.data.roleType == 2
        && request.resource.data.permissions.size() == 0
        && !('merchantStoreId' in request.resource.data);
      allow update: if request.auth.uid == uid
        && affects(['fcmToken', 'displayName', 'avatarType', 'updatedAt', 'application']);
      allow update: if isAdmin();

      // Which posts this user liked. The post id is the document id, and
      // posts/{postId}.likeCount is the counter derived from it.
      match /likedPosts/{postId} {
        allow read, write: if request.auth.uid == uid;
      }
    }

    match /approvedApplications/{storeId} {
      allow read: if true;
      allow write: if isAdmin();
      // Onaylı esnaf kendi mekanının vitrinini ve künyesini yönetir; onay
      // durumu (isApproved), sahiplik (ownerId) ve sayaçlar dışarıda kalır.
      allow update: if resource.data.ownerId == request.auth.uid
        && affects(['showcaseModules', 'description', 'images',
                    'openTime', 'closeTime', 'updatedAt',
                    'name', 'phone', 'address', 'category',
                    'isCommentEnabled']);
      allow update: if isSignedIn()
        && affects(['visitCount'])
        && request.resource.data.visitCount == resource.data.visitCount + 1;
      // Oy create/delete batch'i store sayaçlarını ±1 count / ±(1..5) sum oynatır.
      allow update: if isSignedIn()
        && (movesStoreRatingUp() || movesStoreRatingDown());

      match /votes/{voterUid} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn()
          && voterUid == request.auth.uid
          && request.resource.data.voterUid == request.auth.uid
          && request.resource.data.score is int
          && request.resource.data.score >= 1
          && request.resource.data.score <= 5;
        // Mekan sahibi yalnızca yanıt alanlarına dokunabilir; puan/yorum korunur.
        allow update: if isMerchantOf(storeId)
          && affects(['merchantReply', 'merchantReplyAt'])
          && (request.resource.data.merchantReply is string
              || request.resource.data.merchantReply == null);
        allow delete: if request.auth.uid == voterUid || isAdmin();
      }
    }

    match /merchantApplications/{uid} {
      allow read: if (isSignedIn() && request.auth.uid == uid) || isAdmin();
      allow create: if request.auth.uid == uid
        && request.resource.data.status == 'pending'
        && get(/databases/$(database)/documents/users/$(uid)).data.merchantStoreId == null;
      allow update, delete: if isAdmin();
    }

    match /topics/{topicId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || hasPerm(2);
      allow update, delete: if isAdmin();

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.authorUid == request.auth.uid;
        allow update: if isSoftDelete()
          && (resource.data.authorUid == request.auth.uid || isAdmin());
        allow delete: if false;
      }
    }

    match /groups/{groupId} {
      // The group list is public; joining and reading its content is not.
      allow read: if true;
      allow create: if hasPerm(1)
        && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.memberCount == 1;
      allow update: if isAdmin()
        || (resource.data.creatorUid == request.auth.uid
            && affects(['name', 'description', 'imageUrl', 'categoryValue',
                        'categoryName', 'isClosed', 'updatedAt']))
        || (resource.data.creatorUid == request.auth.uid && isSoftDelete())
        // Sayaç yalnızca çağıranın kendi üyeliğiyle tutarlı yönde oynayabilir:
        // üye olmayan artırır, aktif üye azaltır.
        || (isSignedIn() && movesCounterUp('memberCount')
            && !isGroupMember(groupId))
        || (movesCounterDown('memberCount') && isGroupMember(groupId));
      allow delete: if isAdmin();

      // Membership. Leaving is a soft-delete; counts must filter isDeleted == false.
      match /members/{memberUid} {
        allow read: if isSignedIn();
        allow create: if request.auth.uid == memberUid
          && (request.resource.data.role == 'member' || isGroupOwner(groupId));
        allow update: if isSoftDelete()
          && (request.auth.uid == memberUid || isGroupOwner(groupId) || isAdmin());
        // Rejoining rewrites the membership that leaving soft-deleted.
        allow update: if request.auth.uid == memberUid
          && resource.data.isDeleted == true
          && request.resource.data.isDeleted == false
          // `role` dışarıda: yeniden katılım yetki yükseltmeye dönüşemez.
          && affects(['isDeleted', 'deletedAt', 'updatedAt', 'createdAt',
                      'displayName', 'avatarUrl']);
        allow delete: if false;
      }

      // Wall posts. Members author them; content is immutable and only the
      // like counter moves.
      match /posts/{postId} {
        allow read: if isSignedIn();
        allow create: if isGroupMember(groupId) && isIncomingAuthor();
        allow update: if isGroupMember(groupId) && movesCounterByOne('likeCount');
        allow delete: if false;
      }

      // Discussions and their replies share the same access shape as posts.
      match /discussions/{discussionId} {
        allow read: if isSignedIn();
        allow create: if isGroupMember(groupId) && isIncomingAuthor();
        allow update: if isGroupMember(groupId) && movesCounterByOne('entryCount');
        allow delete: if false;

        match /entries/{entryId} {
          allow read: if isSignedIn();
          allow create: if isGroupMember(groupId) && isIncomingAuthor();
          allow update: if false;
          allow delete: if false;
        }
      }
    }


    match /coupons/{couponId} {
      allow read: if isSignedIn();
      allow create: if isMerchantOf(request.resource.data.storeId)
        && request.resource.data.merchantUid == request.auth.uid
        && request.resource.data.ratio is int
        && request.resource.data.ratio >= 1
        && request.resource.data.ratio <= 100
        && request.resource.data.expiresAt is timestamp;
      allow update, delete: if resource.data.merchantUid == request.auth.uid || isAdmin();

      // Doküman kimliği kullanan uid'idir: bir kullanıcı bir kupondan yalnızca
      // bir kez yararlanabilir, ikinci create aynı kimliğe düşer ve reddedilir.
      match /redemptions/{userUid} {
        allow read: if isCouponOwner(couponId)
          || request.auth.uid == userUid
          || isAdmin();
        allow create: if isCouponOwner(couponId)
          && request.resource.data.userUid == userUid
          && request.resource.data.merchantUid == request.auth.uid
          && !exists(
            /databases/$(database)/documents/coupons/$(couponId)/redemptions/$(userUid)
          );
        allow update, delete: if isAdmin();
      }
    }

    match /regionalCities/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /regionalTowns/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /towns/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /adminList/{document} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /allowedAdminClaims/{document} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /specialAgency/{agency} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /unApprovedApplications/{appId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /notifications/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /developers/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /logs/{document} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    // CollectionPaths.error — written by FirebaseLogger (e.g. push notification
    // failures). Any signed-in user may append; only admins read/mutate.
    // Without this match, writes were denied by default in production.
    match /error/{document} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /approvedCampaigns/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /unApprovedCampaigns/{document} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /categories/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /groupCategories/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /unApprovedAdvertise/{document} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /approvedAdvertise/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /news/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /adBoard/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /scholarship/{scholarship} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /chainStores/{chainStore} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /touristicPlaces/{touristicPlace} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /usefulLinks/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
